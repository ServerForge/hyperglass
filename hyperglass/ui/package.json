  "devDependencies": {
    "@biomejs/biome": "1.5.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.7",
    "@types/dagre": "^0.7.54",
    "@types/lodash": "^4.17.25",
